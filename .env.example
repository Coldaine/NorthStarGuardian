# NorthStarGuardian — environment variable reference
#
# Copy this file to .env and fill in the values for local development.
# Never commit .env to version control.
#
# In GitHub Actions these are set automatically (GITHUB_TOKEN) or via
# repository secrets (ANTHROPIC_API_KEY).

# Required: Anthropic API key for the LLM interview step.
# Obtain from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Note: GITHUB_TOKEN is injected automatically by GitHub Actions and does
# NOT need to be added as a repository secret. For local testing with
# guardian interview / guardian command you can set it to a Personal Access
# Token (PAT) with repo + pull_request scopes:
# GITHUB_TOKEN=ghp_...

# Optional: override the repository for local testing.
# Format: "owner/repo"  (e.g. "acme/my-project")
# GITHUB_REPOSITORY=

# Optional: path to a GitHub event JSON payload for local testing.
# GITHUB_EVENT_PATH=path/to/event.json

# Optional: workspace root (defaults to current directory).
# GITHUB_WORKSPACE=.
